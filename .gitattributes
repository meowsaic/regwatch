# 统一换行符，避免跨平台协作与 checkout 时产生无意义的行尾差异
* text=auto eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.txt  text eol=lf
*.cfg  text eol=lf
*.ini  text eol=lf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
# 二进制文件不做任何转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.docx binary
*.xlsx binary
*.zip  binary

# 大体积数据库文件交给 Git LFS：git 历史里只保留一个指针（约 130 字节），
# 内容存在 LFS 存储，数据更新时重新 add / commit / push 即可。
# 详见 docs/deploy/streamlit-cloud.md（Community Cloud 会自动拉取 LFS）。
data/regwatch.db filter=lfs diff=lfs merge=lfs -text
