# ──────────────────────── 运行时数据（体积巨大，不入库） ────────────────────────
# SQLite 主库及其 WAL / 临时文件
data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
# 云端按需下载数据库时的半成品文件（部署引导生成）
*.download

# AMAC 月度公告 PDF 下载目录
AMAC_Discipline_PDFs/

# 分析与报告产物（本地保留，不入库）
reports/

# 归档专题中的数据导出（案例 JSON）
docs/archive/**/*.json
专项分析报告/**/*.json

# ──────────────────────── 报告与二进制产物 ────────────────────────
*.pdf
*.docx
*.doc
*.xlsx
*.xls
*.pptx
*.zip
*.7z

# ──────────────────────── Python ────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ──────────────────────── 本地配置（含密钥，仅 config.example.json 入库） ────────────────────────
config.json
config.json.*
config.local.json
*.local.json
.streamlit/secrets.toml

# ──────────────────────── 运行时产物 ────────────────────────
logs/
*.log
.cache/
tmp/
.temp/
run/
*.pid

# ──────────────────────── IDE / 工具 ────────────────────────
.trae/
.vscode/
.idea/
# AI 助手本地目录（会话计划与记忆，仅本地保留）
.codebuddy/
*.swp

# ──────────────────────── 系统 ────────────────────────
Thumbs.db
Desktop.ini
.DS_Store
